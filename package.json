{
  "name": "sane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "bin": {
    "sane": "./bin/sane.ts"
  },
  "scripts": {
    "start": "bun run start:app",
    "start:app": "bun packages/sane-app/start.ts",
    "setup:app": "bun packages/sane-app/setup.ts",
    "test:unit": "bun test --path-ignore-patterns=\"**/native-handoff.test.ts\" --path-ignore-patterns=\"**/native-recovery.test.ts\" --path-ignore-patterns=\"**/agent-session-smoke.test.ts\" --path-ignore-patterns=\"**/managed-workers.integration.test.ts\"",
    "test:integration:workstreams": "bun test packages/sane-app/tests/native-handoff.test.ts packages/sane-app/tests/native-recovery.test.ts",
    "test:integration:agents": "bun test packages/sane-app/tests/agent-session-smoke.test.ts",
    "typecheck": "bun run typecheck:workspace && bun run typecheck:app",
    "typecheck:workspace": "tsc --noEmit",
    "typecheck:app": "bun run --cwd packages/sane-app typecheck",
    "build": "bun run build:app",
    "build:app": "bun run --cwd packages/sane-app build"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.8",
    "@types/bun": "^1.3.6",
    "typescript": "^5"
  }
}
