{
  "name": "@agenv/agent-sdk-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated Cursor and OpenCode Agent SDK proof of concept",
  "module": "./src/index.ts",
  "type": "module",
  "bin": {
    "sdk-poc": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./artifacts": "./src/artifacts.ts",
    "./cursor-runner": "./src/cursor-runner.ts",
    "./opencode-runner": "./src/opencode-runner.ts"
  },
  "scripts": {
    "run": "bun run src/cli.ts",
    "test": "bun test tests",
    "test:live": "SDK_POC_CURSOR_E2E=1 bun test tests/cursor-live.test.ts --test-name-pattern='live Cursor'",
    "test:live:opencode": "SDK_POC_OPENCODE_E2E=1 bun test tests/opencode-live.test.ts --test-name-pattern='live OpenCode'",
    "probe:node": "node --experimental-strip-types src/node-entry-probe.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "@opencode-ai/sdk": "^1.18.18"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
