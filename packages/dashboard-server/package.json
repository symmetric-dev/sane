{
  "name": "@agenv/dashboard-server",
  "version": "0.1.0",
  "description": "Internal Bun server for the local workstream dashboard",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "workstream-dashboard": "./bin/dashboard-server.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --hot ./bin/dashboard-server.ts --repo-root ../..",
    "start": "bun ./bin/dashboard-server.ts --repo-root ../..",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agenv/workstreams": "workspace:*",
    "hono": "^4.11.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
